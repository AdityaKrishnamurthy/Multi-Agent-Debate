# --- Model providers (free tiers). At least GROQ_API_KEY is required. ---
# Add a second key from another account with the _2 suffix (then _3, ...): when one
# key hits its rate limit the next one is used, then the next provider (fallback chain
# in backend/app/config/models.yaml).
GROQ_API_KEY=
GROQ_API_KEY_2=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEY_2=
TOKENHARBOR_API_KEY=
TOKENHARBOR_API_KEY_2=
MISTRAL_API_KEY=

# --- Evidence retrieval (plan 008) ---
TAVILY_API_KEY=

# Matches docker-compose.yml. Leave as-is for local development.
DATABASE_URL=postgresql+asyncpg://mad:mad@localhost:5432/mad
